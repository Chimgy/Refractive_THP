PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=refractive_thp

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
AUTH_CACHE_TTL_SECONDS=300

TELEMETRY_HASH_SECRET=change-me-to-a-long-random-string

# 32 raw bytes, base64 — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLOUDFLARE_TOKEN_ENC_KEY=change-me-to-a-32-byte-base64-key
