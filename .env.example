# Used by docker-compose.yml's `cloudflared` service. Copy to `.env`, fill
# in, and `docker compose up cloudflared` gives THP_analytics.js a stable
# public URL on any machine.

# Cloudflare Zero Trust dashboard → Networks → Tunnels → Create a tunnel
# (Cloudflared connector) → the docker run command it shows you contains
# this token. Add a Public Hostname on that same tunnel pointing at
# backend:3000 to pick the actual embed domain.
CLOUDFLARE_TUNNEL_TOKEN=

# Threaded into the `backend` service's environment here, same as every
# other secret it needs — not left to fall back on the .env file bind-mount
# alone (see backend/.env.example), since that pattern won't exist once
# this runs on Fargate with no mounted file, only injected env vars. Must
# match backend/.env's value if both are set. Long random string; used to
# salt the daily per-visitor hash (external_data.md section 1 item 4).
TELEMETRY_HASH_SECRET=

# Threaded into the `internal-cloudflared` service the same way — the tunnel
# that gives internal-frontend/internal-backend a stable public hostname
# behind Cloudflare Access, separate from the customer-facing tunnel above.
INTERNAL_CLOUDFLARE_TUNNEL_TOKEN=

# Threaded into the `demo-cloudflared` service — a separate tunnel pointing
# at `frontend:5173`, giving the customer platform a stable public URL
# (demo.chimgy.net) for showing it to people off this machine. Cloudflare
# Zero Trust dashboard → Networks → Tunnels → Create a tunnel → the docker
# run command it shows you contains this token; add a Public Hostname on
# that tunnel for demo.chimgy.net pointing at frontend:5173.
FRONTEND_DEMO_CLOUDFLARE_TUNNEL_TOKEN=

# internal-backend's only auth: CloudflareAccessGuard verifies the
# `Cf-Access-Jwt-Assertion` header Access attaches to every request against
# these two values, rather than trusting the header's mere presence (see
# internal-backend/src/auth/guards/cloudflare-access.guard.ts). Zero Trust
# dashboard → Settings → Custom Pages for the team domain; Access →
# Applications → this app → Overview → "Application Audience (AUD) Tag".
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Password for the `internal_readonly` Postgres role (backend migration
# AddInternalReadonlyRole) that internal-backend's hourly ingestion pull
# connects to customer `postgres` as — read-only, SELECT on usage_events/
# rum_events only. Same value threaded into both `backend` (creates/sets the
# role's password) and `internal-backend` (authenticates as it) in
# docker-compose.yml. Long random string.
INTERNAL_READONLY_DB_PASSWORD=
