PORT=3001
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=internal_thp

# Auth is Cloudflare Access, not a locally issued JWT
# CloudflareAccessGuard verifies the `Cf-Access-Jwt-Assertion` header against these two values.
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=change-me-to-the-access-application-aud-tag
